# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyTorch checkpoints and large model files
models/checkpoints/*.pth
!models/checkpoints/.gitkeep

# Datasets (large image datasets should not be committed to git)
data/
!data/**/.gitkeep
!data/README.md

# Large model checkpoints
*.pt
*.pth

# Jupyter transient notebooks
pilot_run.ipynb
pilot_output.ipynb
.ipynb_checkpoints/
.pytest_cache/


# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Kaggle packaging and runs
kaggle_upload/
staging_dataset/
runs/
kaggle_celebdf_kernel/

# Generated evaluation artefacts (regenerated by the pipeline).
# The client deliverable and the reports README are tracked; everything
# else in reports/ is a derived output.
reports/*
!reports/README.md
!reports/FINAL_CLIENT_DELIVERABLE.md
!reports/model_benchmark_table.md
!reports/model_benchmark_summary.json
!reports/inference_speed_comparison.png


